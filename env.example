# Arquivo com o intuito de auxiliar sobre quais credenciais são necessárias para o N8N funcionar. Não é necessário preencher e colocar '.env'.

# ====================================================
# 1. CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRESQL)
# ====================================================
# Utilizado no docker-compose.yml do Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=insira_sua_senha_do_banco_aqui
POSTGRES_DB=sistema_distribuicao
TZ=America/Sao_Paulo

# ====================================================
# 2. CONFIGURAÇÕES DO ORQUESTRADOR (N8N)
# ====================================================
# Utilizado no docker-compose.yml do n8n
# Fuso horário para garantir que os relatórios e logs tenham a hora correta
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Domínio público configurado no proxy reverso (Nginx Proxy Manager)
WEBHOOK_URL=https://n8n.seu-dominio.com.br/

# Autenticação do painel de administração do n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin_n8n
N8N_BASIC_AUTH_PASSWORD=insira_senha_do_painel_n8n

# Permite login no n8n usando IP local HTTP (sem SSL) via Hairpin NAT
N8N_SECURE_COOKIE=false 

# ====================================================
# 3. INTEGRAÇÕES DE API (INSERIDAS DENTRO DO N8N)
# ====================================================
# Token do bot fornecido pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAH_sua_chave_do_telegram_aqui

# Chave de API do Google AI Studio (Gemini 1.5 Flash-Lite)
GEMINI_API_KEY=AIzaSy_sua_chave_do_google_aqui
